@startuml
title Диаграмма 7: Удаление бренда (контент-менеджер)

actor "Контент-менеджер" as Manager #B2DFDB
boundary "UI: Админ-панель" as AdminUI #BBDEFB
control "Контроллер брендов" as Controller #FFF9C4
entity "База данных брендов" as DB #FFE0B2

Manager -> AdminUI: 1. Нажимает «Удалить» на карточке бренда
activate AdminUI

AdminUI -> Controller: 2. DELETE /api/brands/{brandId}
activate Controller

Controller -> DB: 3. Удалить бренд и связи с коллекциями товаров
activate DB

DB --> Controller: 4. Бренд удалён (товары не удаляются)
deactivate DB

Controller --> AdminUI: 5. 204 No Content
deactivate Controller

AdminUI --> Manager: 6. Убирает бренд из списка, показывает подтверждение
deactivate AdminUI

@enduml