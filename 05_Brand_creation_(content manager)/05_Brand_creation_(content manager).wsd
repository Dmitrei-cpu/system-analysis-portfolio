@startuml
title Диаграмма 5: Создание бренда (контент-менеджер)

actor "Контент-менеджер" as Manager #B2DFDB
boundary "UI: Админ-панель" as AdminUI #BBDEFB
control "Контроллер брендов" as Controller #FFF9C4
entity "База данных брендов" as DB #FFE0B2

Manager -> AdminUI: 1. Открывает форму создания бренда
activate AdminUI

AdminUI -> Controller: 2. POST /api/brands (payload: name, logo, collectionId)
activate Controller

Controller -> DB: 3. Проверить уникальность названия
activate DB
DB --> Controller: 4. Название уникально
deactivate DB

alt Название уникально
  Controller -> DB: 5. INSERT INTO brands (name, logo, collection_id)
  activate DB
  DB --> Controller: 6. Бренд успешно создан
  deactivate DB
  Controller --> AdminUI: 7. 201 Created
  AdminUI --> Manager: 8. Отображает сообщение «Бренд создан»
else Название уже существует
  Controller --> AdminUI: 7. 409 Conflict («Название не уникально»)
  AdminUI --> Manager: 8. Отображает ошибку
end

deactivate Controller
deactivate AdminUI

@enduml