{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.example.com/schemas/order.json",
  "title": "Order",
  "description": "JSON-схема для описания данных о заказе в системе интернет-магазина",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string",
      "description": "Уникальный идентификатор заказа (формат: ORD-XXXXXX)",
      "pattern": "^ORD-[0-9]{6}$",
      "examples": ["ORD-001234"]
    },
    "customerId": {
      "type": "string",
      "description": "Идентификатор клиента (формат: CUST-XXXXXXXX)",
      "pattern": "^CUST-[A-Z0-9]{8}$",
      "examples": ["CUST-ABC12345"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Дата и время создания заказа в формате ISO 8601",
      "examples": ["2025-01-15T10:30:00Z"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Дата и время последнего обновления заказа в формате ISO 8601",
      "examples": ["2025-01-16T14:20:00Z"]
    },
    "items": {
      "type": "array",
      "description": "Список товаров в заказе",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Уникальный идентификатор товара",
            "examples": ["PRD-001"]
          },
          "name": {
            "type": "string",
            "description": "Название товара",
            "minLength": 1,
            "maxLength": 200,
            "examples": ["Кроссовки Nike Air Max"]
          },
          "quantity": {
            "type": "integer",
            "description": "Количество единиц товара",
            "minimum": 1,
            "examples": [2]
          },
          "price": {
            "type": "number",
            "description": "Цена за единицу товара в рублях",
            "minimum": 0,
            "multipleOf": 0.01,
            "examples": [7990.50]
          }
        },
        "required": ["productId", "name", "quantity", "price"],
        "additionalProperties": false
      }
    },
    "deliveryAddress": {
      "type": "object",
      "description": "Адрес доставки заказа",
      "properties": {
        "street": {
          "type": "string",
          "description": "Улица",
          "examples": ["ул. Тверская"]
        },
        "house": {
          "type": "string",
          "description": "Номер дома",
          "examples": ["15"]
        },
        "apartment": {
          "type": ["string", "null"],
          "description": "Номер квартиры (необязательно)",
          "examples": ["42"]
        },
        "city": {
          "type": "string",
          "description": "Город",
          "examples": ["Москва"]
        },
        "postalCode": {
          "type": "string",
          "description": "Почтовый индекс",
          "pattern": "^[0-9]{6}$",
          "examples": ["101000"]
        }
      },
      "required": ["street", "house", "city", "postalCode"],
      "additionalProperties": false
    }
  },
  "required": ["orderId", "customerId", "createdAt", "items", "deliveryAddress"],
  "additionalProperties": false
}